<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>
    <!-- Custom actions to register/start/stop/remove the daemon service -->
    <CustomAction Id="RegisterService"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]puru-nucleus.exe&quot; service install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="StartService"
                  Directory="INSTALLDIR"
                  ExeCommand="sc.exe start PuruNucleus"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="StopService"
                  Directory="INSTALLDIR"
                  ExeCommand="sc.exe stop PuruNucleus"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveService"
                  Directory="INSTALLDIR"
                  ExeCommand="sc.exe delete PuruNucleus"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopService" Before="RemoveService">
        REMOVE="ALL"
      </Custom>
      <Custom Action="RemoveService" Before="RemoveFiles">
        REMOVE="ALL"
      </Custom>
      <Custom Action="RegisterService" After="InstallFiles">
        NOT REMOVE
      </Custom>
      <Custom Action="StartService" After="RegisterService">
        NOT REMOVE
      </Custom>
    </InstallExecuteSequence>

    <!-- Empty component group to satisfy the componentGroupRefs -->
    <ComponentGroup Id="PuruNucleusService" />
  </Fragment>

</Wix>
