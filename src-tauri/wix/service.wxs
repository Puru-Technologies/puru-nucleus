<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>
    <ComponentGroup Id="PuruNucleusService">
      <Component Id="ServiceComponent" Directory="INSTALLDIR" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
        <ServiceInstall
          Id="PuruNucleusServiceInstall"
          Name="PuruNucleus"
          DisplayName="Puru Nucleus"
          Description="Puru Nucleus - Hospital Deployment Manager daemon (backups, telemetry, watchdog)"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Arguments="daemon"
          Account="LocalSystem" />

        <ServiceControl
          Id="PuruNucleusServiceStart"
          Name="PuruNucleus"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
